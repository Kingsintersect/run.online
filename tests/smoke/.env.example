# Smoke-suite configuration. Copy to tests/smoke/.env (gitignored) or export
# these in your shell. Placeholder values only — never commit real credentials.

# Required. No default. Non-local hosts are refused unless SMOKE_ALLOW_REMOTE=1.
SMOKE_BASE_URL=http://localhost:3031
# SMOKE_ALLOW_REMOTE=1

# Optional: limit roles (comma-separated) or "none" for public pages only.
# SMOKE_ROLES=DEAN,HOD

# Per-role credentials — uncomment and fill in the roles you want to test.
# A role with either value missing is skipped with a message.
# SMOKE_SUPER_ADMIN_EMAIL=superadmin@example.com
# SMOKE_SUPER_ADMIN_PASSWORD=change-me
# SMOKE_ADMIN_EMAIL=admin@example.com
# SMOKE_ADMIN_PASSWORD=change-me
# SMOKE_STAFF_EMAIL=staff@example.com
# SMOKE_STAFF_PASSWORD=change-me
# SMOKE_DEAN_EMAIL=dean@example.com
# SMOKE_DEAN_PASSWORD=change-me
# SMOKE_HOD_EMAIL=hod@example.com
# SMOKE_HOD_PASSWORD=change-me
# SMOKE_TUTOR_EMAIL=tutor@example.com
# SMOKE_TUTOR_PASSWORD=change-me
# SMOKE_BURSARY_EMAIL=bursary@example.com
# SMOKE_BURSARY_PASSWORD=change-me
# SMOKE_DIRECTOR_EMAIL=director@example.com
# SMOKE_DIRECTOR_PASSWORD=change-me
# SMOKE_STUDENT_EMAIL=student@example.com
# SMOKE_STUDENT_PASSWORD=change-me
# SMOKE_APPLICANT_EMAIL=applicant@example.com
# SMOKE_APPLICANT_PASSWORD=change-me

# Optional tuning (milliseconds unless noted).
# SMOKE_NAV_TIMEOUT_MS=120000
# SMOKE_SETTLE_MS=2500
# SMOKE_SPINNER_TIMEOUT_MS=20000
# SMOKE_ISOLATION_COUNT=4        (number of other-role homes to probe)
# SMOKE_MIN_MAIN_TEXT=15         (chars; below this <main> counts as blank)
# SMOKE_HEADED=1
# SMOKE_OUTPUT_DIR=tests/smoke/.output
